// prisma/schema.prisma
// CareerTrack - Mentoring & Activity Log System

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  role      Role     @default(EMPLOYEE)
  
  // Self-relation for Manager-Subordinate
  managerId String?
  manager   User?    @relation("ManagerSubordinate", fields: [managerId], references: [id])
  subordinates User[] @relation("ManagerSubordinate")

  dailyLogs     DailyLog[]
  weeklyReports WeeklyReport[]
  careerGoals   CareerGoal[]
  
  createdAt DateTime @default(now())
}

model DailyLog {
  id        String   @id @default(uuid())
  date      DateTime @default(now())
  content   String   @db.Text 
  mood      String?  // Can be emoji or scale
  
  weeklyReportId String?
  weeklyReport   WeeklyReport? @relation(fields: [weeklyReportId], references: [id])
  
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WeeklyReport {
  id              String   @id @default(uuid())
  startDate       DateTime
  endDate         DateTime
  weekNumber      Int
  year            Int
  summary         String?  @db.Text 
  managerFeedback String?  @db.Text
  status          ReportStatus @default(DRAFT)
  
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  
  dailyLogs   DailyLog[] 
  attachments Attachment[] 
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([userId, weekNumber, year])
}

model Attachment {
  id             String   @id @default(uuid())
  fileName       String
  fileUrl        String
  weeklyReportId String
  weeklyReport   WeeklyReport @relation(fields: [weeklyReportId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
}

model CareerGoal {
  id             String    @id @default(uuid())
  title          String
  description    String    @db.Text
  targetDate     DateTime?
  status         GoalStatus @default(IN_PROGRESS)
  managerComment String?   @db.Text
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  REVIEWED
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}