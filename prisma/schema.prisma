// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(EMPLOYEE) 
  createdAt DateTime @default(now())
  logs      LogActivity[]
  weeklyLogs WeeklyLog[]
}

model LogActivity {
  id          String    @id @default(uuid())
  title       String
  description String
  date        DateTime  @default(now())
  duration    Int
  status      LogStatus @default(SUBMITTED)
  mood        String?
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  createdAt   DateTime  @default(now())
}

model WeeklyLog {
  id          String    @id @default(uuid())
  weekStart   DateTime  // Tanggal awal minggu (Senin)
  weekEnd     DateTime  // Tanggal akhir minggu (Minggu)
  weekNumber  Int       // Nomor minggu dalam tahun
  year        Int       // Tahun
  title       String
  description String    @db.Text
  summary     String?   @db.Text // Ringkasan mingguan
  totalDuration Int     @default(0) // Total durasi dalam menit
  status      LogStatus @default(SUBMITTED)
  mood        String?
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  attachments WeeklyLogAttachment[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, weekNumber, year])
}

model WeeklyLogAttachment {
  id          String    @id @default(uuid())
  fileName    String
  fileUrl     String
  fileType    String    // document, image, other
  fileSize    Int       // dalam bytes
  weeklyLogId String
  weeklyLog   WeeklyLog @relation(fields: [weeklyLogId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum LogStatus {
  DRAFT
  SUBMITTED
  REVIEWED
}